# Notion Atomic Notes — Environment Variables
# Copy this file to .env and fill in your values.

# Required: Notion integration token
NOTION_TOKEN=ntn_your_token_here

# Required: Anthropic API key
ANTHROPIC_API_KEY=sk-ant-your_key_here

# Optional: Knowledge Base database ID
KB_DATABASE_ID=your_kb_database_id

# Optional: Claude model (default: claude-sonnet-4-6)
# CLAUDE_MODEL=claude-sonnet-4-6

# Optional: Notion API rate limit in requests/second (default: 3.0)
# NOTION_RATE_LIMIT_RPS=3.0
