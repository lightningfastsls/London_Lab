{
  "hooks": {
    "Stop": [
      {
        "matcher": "",
        "hooks": [
          {
            "type": "command",
            "command": "powershell -ExecutionPolicy Bypass -File .claude/hooks/check_agents_tag.ps1"
          }
        ]
      }
    ],
    "PreToolUse": [
      {
        "matcher": "Edit|Write",
        "hooks": [
          {
            "type": "command",
            "command": "powershell -ExecutionPolicy Bypass -File .claude/hooks/check_plan_mode.ps1"
          }
        ]
      }
    ]
  },
  "permissions": {
    "allow": [
      "Read(*)",
      "Edit",
      "Write",
      "WebFetch",
      "WebSearch",
      "Bash(python*)",
      "Bash(pytest*)",
      "Bash(pip *)",
      "Bash(pip install*)",
      "Bash(pip list*)",
      "Bash(black*)",
      "Bash(flake8*)",
      "Bash(isort*)",
      "Bash(git *)",
      "Bash(git status*)",
      "Bash(git diff*)",
      "Bash(git add*)",
      "Bash(git commit*)",
      "Bash(git log*)",
      "Bash(git branch*)",
      "Bash(gh *)",
      "Bash(streamlit *)",
      "Bash(dir*)",
      "Bash(ls*)",
      "Bash(mkdir *)",
      "Bash(mv *)",
      "Bash(rm *)",
      "Bash(cat*)",
      "Bash(type*)",
      "Bash(echo*)",
      "Bash(cd*)",
      "Bash(.venv*)",
      "Bash(.venv/**)",
      "Bash(C:/Users/light/PycharmProjects/mickey_london_lab/.venv/Scripts/python.exe*)",
      "Bash(C:/Users/light/PycharmProjects/mickey_london_lab/.venv/Scripts/pip.exe*)"
    ],
    "deny": [
      "Read(.env)",
      "Read(.env.*)",
      "Read(**/secrets/**)",
      "Read(**/credentials*)",
      "Write(.env)",
      "Write(.env.*)"
    ]
  }
}
