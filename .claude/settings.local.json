{
  "permissions": {
    "allow": [
      "Read(*)",
      "Edit",
      "Write",
      "WebFetch",
      "WebSearch",
      "Bash(python*)",
      "Bash(pytest*)",
      "Bash(pip *)",
      "Bash(git *)",
      "Bash(gh *)",
      "Bash(streamlit *)",
      "Bash(dir*)",
      "Bash(ls*)",
      "Bash(mkdir *)",
      "Bash(mv *)",
      "Bash(rm *)",
      "Bash(cat*)",
      "Bash(type*)",
      "Bash(echo*)",
      "Bash(cd*)",
      "Bash(.venv*)",
      "Bash(.venv/**)",
      "Bash(.venv/Scripts/python.exe:*)",
      "Bash(powershell.exe:*)",
      "Bash(powershell -Command:*)",
      "Bash(cmd /c:*)",
      "Bash(cmd.exe /c:*)",
      "Bash(explorer.exe:*)",
      "Bash(find:*)",
      "Bash(grep:*)",
      "Bash(findstr:*)",
      "Bash(wc:*)",
      "Bash(test:*)",
      "Bash(shuf)"
    ],
    "deny": [
      "Read(.env)",
      "Read(.env.*)",
      "Read(**/secrets/**)",
      "Read(**/credentials*)",
      "Write(.env)",
      "Write(.env.*)"
    ]
  },
  "hooks": {
    "SessionStart": [
      {
        "hooks": [
          {
            "type": "command",
            "command": "powershell.exe -NoProfile -NonInteractive -ExecutionPolicy Bypass -File .claude/hooks/session-orient.ps1 || true"
          }
        ]
      }
    ],
    "Stop": [
      {
        "matcher": "",
        "hooks": [
          {
            "type": "command",
            "command": "powershell.exe -NoProfile -NonInteractive -ExecutionPolicy Bypass -File .claude/hooks/check_agents_tag.ps1 || true"
          }
        ]
      },
      {
        "hooks": [
          {
            "type": "command",
            "command": "powershell.exe -NoProfile -NonInteractive -ExecutionPolicy Bypass -File .claude/hooks/session-capture.ps1 || true"
          }
        ]
      }
    ],
    "PreToolUse": [
      {
        "matcher": "Edit|Write",
        "hooks": [
          {
            "type": "command",
            "command": "powershell.exe -NoProfile -NonInteractive -ExecutionPolicy Bypass -File .claude/hooks/check_plan_mode.ps1 || true"
          }
        ]
      }
    ],
    "PostToolUse": [
      {
        "matcher": "Write",
        "hooks": [
          {
            "type": "command",
            "command": "powershell.exe -NoProfile -NonInteractive -ExecutionPolicy Bypass -File .claude/hooks/validate-note.ps1"
          },
          {
            "type": "command",
            "command": "powershell.exe -NoProfile -NonInteractive -ExecutionPolicy Bypass -File .claude/hooks/auto-commit.ps1 || true",
            "async": true
          }
        ]
      }
    ]
  },
  "outputStyle": "Explanatory"
}
